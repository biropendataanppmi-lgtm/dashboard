{
  "name": "sistem-pendataan-ppmi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistem Pendataan PPMI Mesir 2026/2027 — Biro Data dan Statistika",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply ppmi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ppmi-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply ppmi-db --remote && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
