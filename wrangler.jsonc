// Konfigurasi Cloudflare Worker. Nilai rahasia TIDAK ditulis di sini (lihat docs/DEPLOYMENT.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nationaldatabaseppmi",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ppmi-db",
      // Database D1 produksi milik akun Cloudflare Biro (ID ini bukan rahasia).
      "database_id": "85c13ac7-f9d5-442f-a237-6aad96a7a590",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Produksi selalu "access". Mode "dev" hanya diaktifkan lewat .dev.vars di komputer lokal.
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "icy-glitter-fb5f.cloudflareaccess.com",
    "ACCESS_AUD": "48d44c88f74070598fb303da1c3ff6e564a02899ba9a9d68f2672863be62af4f"
  },
  "observability": { "enabled": true }
}
